# Configuración de Entorno para Docker Compose y Producción
# Copie este archivo a .env y configure los valores correspondientes

# Base de datos PostgreSQL
POSTGRES_DB=marketplace_erp
POSTGRES_USER=marketplace_user
POSTGRES_PASSWORD=

# Backend API
ASPNETCORE_ENVIRONMENT=Production
DATABASE_URL=
CONNECTION_STRING=

# JWT Authentication
JWT_KEY=
JWT_ISSUER=MarketplaceERP
JWT_AUDIENCE=MarketplaceERP.Clients
JWT_EXPIRATION_MINUTES=60

# Admin Inicial (Requerido en Producción)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
