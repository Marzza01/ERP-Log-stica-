# Plantilla sin secretos: Docker Compose y configuración externa de la API
# No incluir valores reales en Git. La API .NET no carga este archivo automáticamente.
# Consulte docs/Configuracion_Segura.md antes de configurar o iniciar servicios.

# Base de datos PostgreSQL de Compose: solo red interna, sin puerto publicado al host.
POSTGRES_DB=marketplace_erp
POSTGRES_USER=marketplace_user
POSTGRES_PASSWORD=

# Backend API
# Variables canónicas para ejecutar .NET directamente (inyectarlas en el proceso).
ConnectionStrings__DefaultConnection=
Jwt__Key=
Cors__AllowedOrigins__0=http://localhost:5173
ASPNETCORE_ENVIRONMENT=Production
DATABASE_URL=
# Compose requiere CONNECTION_STRING completa dirigida a Host=db;Port=5432.
# No usar localhost, host.docker.internal ni destinos PostgreSQL del host.
# No incluir credenciales reales aquí. En .NET directo es un alias opcional.
CONNECTION_STRING=

# Docker Compose: JWT_KEY se transmite a Jwt__Key y es obligatorio.
# JWT_KEY no es un alias que Program.cs lea directamente.
# JWT Authentication
JWT_KEY=
JWT_ISSUER=MarketplaceERP
JWT_AUDIENCE=MarketplaceERP.Clients
JWT_EXPIRATION_MINUTES=60

# Admin Inicial (Requerido en Producción)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Pagos & Checkout
# En Production, si no hay pasarela real configurada, el checkout responde 503 por seguridad,
# a menos que PAYMENTS__ALLOWMOCK esté explícitamente habilitado en true.
PAYMENTS__ALLOWMOCK=false
PAYMENTS__SIMULATEFAILURES=false
CHECKOUT__COSTOENVIODEFAULT=5.00
