<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MarketplaceERP.API</RootNamespace>
    <AssemblyName>MarketplaceERP.API</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.7.3" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <!-- F273: fijar parches NuGet contra CVE-2024-43483 y CVE-2024-43485. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- API es la capa de composición: referencia todos los módulos -->
    <ProjectReference Include="..\MarketplaceERP.Shared\MarketplaceERP.Shared.csproj" GlobalPropertiesToRemove="CheckoutQaHarness" />
    <ProjectReference Include="..\MarketplaceERP.Core\MarketplaceERP.Core.csproj" GlobalPropertiesToRemove="CheckoutQaHarness" />
    <ProjectReference Include="..\MarketplaceERP.Catalog\MarketplaceERP.Catalog.csproj" GlobalPropertiesToRemove="CheckoutQaHarness" />
    <ProjectReference Include="..\MarketplaceERP.Finance\MarketplaceERP.Finance.csproj" GlobalPropertiesToRemove="CheckoutQaHarness" />
  </ItemGroup>

  <!-- Los prototipos de simulación nunca entran al binario desplegable por defecto.
       Únicamente una compilación de tests QA puede habilitarlos expresamente. -->
  <ItemGroup Condition="'$(CheckoutQaHarness)' != 'true'">
    <Compile Remove="Controllers\CheckoutV2QaQuoteController.cs" />
    <Compile Remove="Controllers\CheckoutV2QaSimulatedController.cs" />
    <Compile Remove="Services\QaPrePagoRecoveryService.cs" />
    <!-- Los helpers para pagos y reservas QA son solo para TestServer. -->
    <Compile Remove="Services\CierreCheckoutAdminQaService.cs" />
    <Compile Remove="Services\QaIntentoReservasMapService.cs" />
    <Compile Remove="Services\QaMultiSkuCierreTransaccionalService.cs" />
    <Compile Remove="Services\QaMultiSkuCotizacionCanonica.cs" />
    <Compile Remove="Services\QaMultiSkuPagoSimuladoService.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\MarketplaceERP.Catalog\SeedData\**" Link="SeedData\%(RecursiveDir)%(FileName)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
