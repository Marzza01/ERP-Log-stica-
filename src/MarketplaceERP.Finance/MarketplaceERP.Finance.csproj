<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MarketplaceERP.Finance</RootNamespace>
    <AssemblyName>MarketplaceERP.Finance</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Permite que el proyecto de tests y el proyecto de API accedan a clases internas (ej: CheckoutOrchestrator, PagoServiceMock) -->
    <InternalsVisibleTo Include="MarketplaceERP.Finance.Tests" />
    <InternalsVisibleTo Include="MarketplaceERP.API" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Finance puede ver Shared y Core (para las interfaces y DTOs compartidos) -->
    <!-- REGLA DE ORO: Finance NO puede referenciar Catalog -->
    <ProjectReference Include="..\MarketplaceERP.Shared\MarketplaceERP.Shared.csproj" />
    <ProjectReference Include="..\MarketplaceERP.Core\MarketplaceERP.Core.csproj" />
  </ItemGroup>

</Project>
